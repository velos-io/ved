# ─────────────────────────────────────────────────────────────────────────────
# config/.env — committed base configuration
# No secrets. Developers override in config/.local.env (gitignored).
# ─────────────────────────────────────────────────────────────────────────────

# Deployment target — controls every lifecycle target (up, down, ps, reset)
# compose  -> Docker Compose (default for local dev)
# k8s      -> Kubernetes (kustomize or helm)
DEPLOYMENT_TARGET=k8s

# Kubernetes deployer — only used when DEPLOYMENT_TARGET=k8s
K8S_DEPLOYER=kustomize

# Kubernetes slot number -> agent namespace ns-{slot}
K8S_APP_SLOT=1

# Private registry URLs — leave blank for local dev without a private registry
INTERNAL_REGISTRY=
EXTERNAL_REGISTRY_MIRROR=

# Feature flags
REDIS_ENABLED=true
OTEL_ENABLED=false
ENABLE_REPORT_EXPORT=false
K8S_RUN_MIGRATIONS=true

# Local dev defaults
DB_PASSWORD=postgres
