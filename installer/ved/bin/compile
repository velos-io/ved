#!/usr/bin/env bash
# installer/ved/bin/compile
# Shell wrapper for generate.py.
# Finds or creates a .venv with pyyaml, then delegates all arguments to generate.py.
#
# Usage (called by Makefile):
#   installer/ved/bin/compile <spec.yaml> <out-compose.yml> [out-values.yaml] [out-kustomize-dir] [--org ORG] [--env K=V ...]

set -euo pipefail

# Resolve paths relative to the project root (two levels up from bin/)
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
VED_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
PROJECT_ROOT="$(cd "${VED_DIR}/../.." && pwd)"
GENERATE="${VED_DIR}/generate.py"
VENV_DIR="${PROJECT_ROOT}/.venv"

# Validate generate.py exists
if [ ! -f "$GENERATE" ]; then
  echo "ERROR: ${GENERATE} not found." >&2
  echo "       T2 (generate-py-core) must be implemented before running compile." >&2
  exit 1
fi

# Create virtualenv if absent
if [ ! -d "$VENV_DIR" ]; then
  echo "compile: creating Python virtualenv at ${VENV_DIR}"
  python3 -m venv "$VENV_DIR"
fi

# Install pyyaml (pip is idempotent — fast no-op when already installed)
"${VENV_DIR}/bin/pip" install --quiet pyyaml

# Delegate to generate.py with all arguments
echo "compile: running generate.py $*"
"${VENV_DIR}/bin/python" "$GENERATE" "$@"
echo "compile: done"
